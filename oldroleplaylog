<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Roleplay Log</title>
<style>
:root{--bg:#07060a;--panel:#0e0b13;--panel2:#15101c;--line:#2a1d35;--purple:#a84cff;--purple2:#d889ff;--text:#eee9f4;--muted:#9b92a6;--danger:#e45757;--ok:#51d68a}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 20% 0%,#251037 0,#0a0810 35%,#050509 100%);color:var(--text);font:14px Arial,sans-serif;min-height:100vh}
button,input,textarea,select{font:inherit}button{cursor:pointer}.hidden{display:none!important}
.auth{min-height:100vh;display:grid;place-items:center;padding:20px}.authbox{width:min(430px,100%);background:#0e0b13eF;border:1px solid var(--line);border-radius:20px;padding:28px;box-shadow:0 25px 80px #0008}.brand.big{margin:0 0 24px;border:0;padding:0}.brand{display:flex;align-items:center;gap:12px}.brand img{width:48px;height:48px;object-fit:contain}.brand b{font-size:18px}.brand small{display:block;color:var(--muted);margin-top:3px}.auth h1{margin:0 0 7px}.auth p{color:var(--muted)}label{display:block;color:#cfc6d8;margin:12px 0 6px}.field,.modal input,.modal textarea,.modal select{width:100%;background:#0b0910;border:1px solid var(--line);color:#fff;border-radius:9px;padding:12px;outline:none}.field:focus,.modal input:focus,.modal textarea:focus,.modal select:focus{border-color:#8744b7}.primary{background:linear-gradient(135deg,#8f35e8,#c765ff);border:0;color:#fff;padding:12px 18px;border-radius:10px;font-weight:bold;box-shadow:0 8px 30px #8e38e633}.secondary{background:#15101c;border:1px solid var(--line);color:#eee;padding:10px 14px;border-radius:9px}.danger{background:#34151a;border:1px solid #66242c;color:#ffdfe1;padding:10px 14px;border-radius:9px}.tabs{display:flex;gap:8px;margin:18px 0}.tabs button{flex:1}.app{display:flex;min-height:100vh}.side{width:260px;background:#0a080ef5;border-right:1px solid var(--line);padding:22px 14px;position:fixed;inset:0 auto 0 0;overflow:auto}.brand{padding:4px 10px 22px;border-bottom:1px solid var(--line);margin-bottom:15px}.nav{display:grid;gap:6px}.nav button{border:0;background:transparent;color:#bcb3c8;text-align:left;padding:11px 12px;border-radius:10px}.nav button:hover,.nav button.active{background:linear-gradient(90deg,#241330,#17101f);color:#fff}.main{margin-left:260px;width:calc(100% - 260px);padding:28px;max-width:1500px}.top{display:flex;justify-content:space-between;align-items:center;gap:15px;margin-bottom:18px}.title h1{margin:0;font-size:28px}.title p{margin:7px 0;color:var(--muted)}.top-actions,.actions,.filters{display:flex;gap:8px;flex-wrap:wrap}.tools{display:grid;grid-template-columns:1fr 180px 180px;gap:10px;margin-bottom:16px}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:16px}.stat,.card,.panel{background:linear-gradient(145deg,#16101df5,#0b090ff5);border:1px solid var(--line);border-radius:14px}.stat{padding:15px}.stat b{font-size:23px}.stat small{display:block;color:var(--muted);margin-top:4px}.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:15px}.card{padding:18px;min-height:175px;transition:.18s}.card:hover{transform:translateY(-3px);border-color:#684080}.card h3{margin:10px 0 8px}.card p{color:#c0b7c8;line-height:1.5}.tag{display:inline-block;padding:5px 8px;border-radius:999px;background:#26152f;color:#dbaaff;font-size:12px}.meta{color:var(--muted);font-size:12px;margin-top:10px}.card-actions{display:flex;gap:7px;margin-top:12px}.card-actions button{background:#0d0a12;border:1px solid var(--line);color:#ddd;border-radius:8px;padding:7px 10px}.panel{padding:18px;margin-bottom:15px}.panel h2{margin-top:0}.table{width:100%;border-collapse:collapse}.table th,.table td{padding:10px;border-bottom:1px solid var(--line);text-align:left}.modalbg{position:fixed;inset:0;background:#000b;display:none;align-items:center;justify-content:center;padding:20px;z-index:20}.modal{width:min(680px,100%);max-height:90vh;overflow:auto;background:#0e0b13;border:1px solid var(--line);border-radius:16px;padding:20px}.modal textarea{min-height:220px;resize:vertical}.toast{position:fixed;right:20px;bottom:20px;background:#17101f;border:1px solid #684080;padding:12px 16px;border-radius:10px;display:none;z-index:40}.empty{text-align:center;padding:60px;color:var(--muted)}
@media(max-width:850px){.side{width:210px}.main{margin-left:210px;width:calc(100% - 210px);padding:18px}.tools{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}}
@media(max-width:620px){.app{display:block}.side{position:static;width:100%;height:auto}.main{margin:0;width:100%}.nav{grid-template-columns:repeat(2,1fr)}.top{display:block}.top-actions{margin-top:12px}.stats{grid-template-columns:1fr 1fr}.table{font-size:12px}}
</style>
</head>
<body>
<section id="auth" class="auth">
  <div class="authbox">
    <div class="brand big"><div id="authLogo"></div><div><b id="authName">ROLEPLAY LOG</b><small>Arşiv & Not Merkezi</small></div></div>
    <h1 id="authTitle">Giriş yap</h1><p id="authHint">Hesabınla devam et.</p>
    <div id="authForm">
      <label>E-posta</label><input id="email" class="field" type="email" autocomplete="email">
      <label>Şifre</label><input id="password" class="field" type="password" autocomplete="current-password">
      <button id="authBtn" class="primary" style="width:100%;margin-top:16px" onclick="submitAuth()">Giriş Yap</button>
      <button class="secondary" style="width:100%;margin-top:9px" onclick="toggleAuth()">Hesap oluştur</button>
    </div>
  </div>
</section>

<section id="app" class="app hidden">
<aside class="side">
  <div class="brand"><div id="sideLogo"></div><div><b id="siteName">ROLEPLAY LOG</b><small>Arşiv & Not Merkezi</small></div></div>
  <div class="nav" id="nav"></div>
  <button class="secondary" style="width:100%;margin-top:15px" onclick="signOut()">Çıkış Yap</button>
</aside>
<main class="main">
  <div class="top"><div class="title"><h1 id="heading">Tüm Kayıtlar</h1><p id="subheading">Notlarını yönet.</p></div><div class="top-actions"><button class="secondary" onclick="exportData()">⬇ Yedekle</button><button class="primary" onclick="openNew()">＋ Yeni Not</button></div></div>
  <div id="content"></div>
</main>
</section>

<div class="modalbg" id="editor"><div class="modal">
<h2 id="editorTitle">Yeni Not</h2><label>Kategori</label><select id="cat"></select>
<label>Başlık</label><input id="title" placeholder="Başlık">
<label>Not</label><textarea id="noteContent" placeholder="Detayları buraya yaz..."></textarea>
<div class="actions" style="margin-top:14px"><button class="secondary" onclick="closeModal()">Vazgeç</button><button class="primary" onclick="saveNote()">Kaydet</button></div>
</div></div>
<div class="toast" id="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
/* Supabase ayarlarını doldur. Sadece anon/publishable key kullan; service_role key'i asla tarayıcıya koyma. */
const SUPABASE_URL = "YOUR_SUPABASE_URL";
const SUPABASE_ANON_KEY = "YOUR_SUPABASE_ANON_KEY";
let sb=null, session=null, profile=null, categories=[], currentCat="Tümü", editingId=null, authMode="login", notes=[];

function configured(){return !SUPABASE_URL.includes("YOUR_")&&!SUPABASE_ANON_KEY.includes("YOUR_")}
function toast(m){let x=document.getElementById("toast");x.textContent=m;x.style.display="block";clearTimeout(window.__t);window.__t=setTimeout(()=>x.style.display="none",2400)}
function esc(s){return String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
function isAdmin(){return profile?.role==="admin"}
function toggleAuth(){authMode=authMode==="login"?"signup":"login";document.getElementById("authTitle").textContent=authMode==="login"?"Giriş yap":"Hesap oluştur";document.getElementById("authHint").textContent=authMode==="login"?"Hesabınla devam et.":"Yeni hesabını oluştur.";document.getElementById("authBtn").textContent=authMode==="login"?"Giriş Yap":"Kayıt Ol"}
async function submitAuth(){
 if(!configured())return alert("Önce Supabase URL ve anon key bilgilerini index.html içine eklemelisin.");
 const email=document.getElementById("email").value.trim(),password=document.getElementById("password").value;
 if(!email||password.length<6)return alert("E-posta gir ve en az 6 karakterlik şifre kullan.");
 let r=authMode==="login"?await sb.auth.signInWithPassword({email,password}):await sb.auth.signUp({email,password});
 if(r.error)return alert(r.error.message);
 if(authMode==="signup"&&!r.data.session)alert("Kayıt başarılı. E-posta doğrulaması açıksa gelen kutunu kontrol et.");
}
async function signOut(){await sb.auth.signOut()}
async function boot(){
 if(!configured()){document.getElementById("authHint").textContent="Supabase bağlantısını ayarladıktan sonra site aktif olur.";return}
 sb=supabase.createClient(SUPABASE_URL,SUPABASE_ANON_KEY);
 sb.auth.onAuthStateChange(async(_e,s)=>{session=s;if(s)await loadApp();else showAuth()});
 const r=await sb.auth.getSession();session=r.data.session;if(session)await loadApp();
}
function showAuth(){document.getElementById("auth").classList.remove("hidden");document.getElementById("app").classList.add("hidden")}
async function loadApp(){
 let p=await sb.from("profiles").select("*").eq("id",session.user.id).single();
 if(p.error){alert("Profil bulunamadı. SQL kurulumunu kontrol et.");return}
 profile=p.data;document.getElementById("auth").classList.add("hidden");document.getElementById("app").classList.remove("hidden");
 await loadSettings();await loadCategories();await loadNotes();renderNav();renderHome();
}
async function loadSettings(){
 const r=await sb.from("site_settings").select("*").limit(1).single();
 if(r.data){document.getElementById("siteName").textContent=r.data.site_name;document.getElementById("authName").textContent=r.data.site_name;document.title=r.data.site_name;if(r.data.logo_url){document.getElementById("sideLogo").innerHTML='<img src="'+esc(r.data.logo_url)+'" style="width:48px;height:48px;object-fit:contain">';document.getElementById("authLogo").innerHTML='<img src="'+esc(r.data.logo_url)+'" style="width:48px;height:48px;object-fit:contain">'}}
}
async function loadCategories(){let r=await sb.from("categories").select("*").order("name");categories=r.data||[]}
async function loadNotes(){let q=sb.from("notes").select("*").order("updated_at",{ascending:false});if(!isAdmin())q=q.eq("user_id",session.user.id);let r=await q;notes=r.data||[]}
function renderNav(){let base=["Tümü",...categories.map(x=>x.name),"Arşiv"];if(isAdmin())base.push("Admin Paneli");document.getElementById("nav").innerHTML=[...new Set(base)].map(c=>`<button class="${c===currentCat?'active':''}" onclick="selectCat('${esc(c).replaceAll("'","&#039;")}')">${esc(c)}</button>`).join("")}
function selectCat(c){currentCat=c;renderNav();if(c==="Admin Paneli"){renderAdmin();return}renderHome()}
function renderHome(){
 document.getElementById("heading").textContent=currentCat==="Tümü"?"Tüm Kayıtlar":currentCat;
 let arr=notes.filter(n=>currentCat==="Tümü"?( !n.archived):currentCat==="Arşiv"?n.archived:(!n.archived&&n.category===currentCat));
 document.getElementById("subheading").textContent=`${arr.length} kayıt • ${profile?.role==="admin"?"Yönetici":"Kullanıcı"}`;
 document.getElementById("content").innerHTML=`<div class="stats"><div class="stat"><b>${notes.length}</b><small>Toplam</small></div><div class="stat"><b>${notes.filter(n=>!n.archived).length}</b><small>Aktif</small></div><div class="stat"><b>${notes.filter(n=>n.archived).length}</b><small>Arşiv</small></div><div class="stat"><b>${categories.length}</b><small>Kategori</small></div></div>
 <div class="tools"><input id="search" class="field" placeholder="Başlık, içerik, kategori veya kullanıcı ara..." oninput="filterCards()"><select id="sort" class="field" onchange="filterCards()"><option value="updated">Son güncellenen</option><option value="title">Başlık</option><option value="category">Kategori</option></select><select id="status" class="field" onchange="filterCards()"><option value="all">Tüm durumlar</option><option value="active">Aktif</option><option value="archived">Arşiv</option></select></div>
 <div class="grid" id="grid"></div>`;filterCards()
}
function filterCards(){
 let q=(document.getElementById("search")?.value||"").toLowerCase(),sort=document.getElementById("sort")?.value||"updated",status=document.getElementById("status")?.value||"all";
 let arr=notes.filter(n=>{let catOk=currentCat==="Tümü"?!n.archived:currentCat==="Arşiv"?n.archived:n.category===currentCat&&!n.archived;let qOk=(n.title+" "+n.content+" "+n.category+" "+(n.user_email||"")).toLowerCase().includes(q);let sOk=status==="all"||(status==="active"&&!n.archived)||(status==="archived"&&n.archived);return catOk&&qOk&&sOk});
 arr.sort((a,b)=>sort==="title"?a.title.localeCompare(b.title,"tr"):sort==="category"?a.category.localeCompare(b.category,"tr"):b.updated_at.localeCompare(a.updated_at));
 document.getElementById("grid").innerHTML=arr.length?arr.map(n=>`<article class="card"><span class="tag">${esc(n.category)}</span><h3>${esc(n.title)}</h3><p>${esc(n.content.slice(0,240))}${n.content.length>240?"…":""}</p><div class="meta">${new Date(n.updated_at).toLocaleString("tr-TR")}${isAdmin()&&n.user_email?" • "+esc(n.user_email):""}</div><div class="card-actions"><button onclick="editNote('${n.id}')">Düzenle</button><button onclick="toggleArchive('${n.id}')">${n.archived?"Geri Al":"Arşivle"}</button><button onclick="deleteNote('${n.id}')">Sil</button></div></article>`).join(""):`<div class="empty">Bu filtrelerde kayıt bulunamadı.</div>`
}
function openNew(){editingId=null;document.getElementById("editorTitle").textContent="Yeni Not";document.getElementById("cat").innerHTML=categories.map(c=>`<option value="${c.id}">${esc(c.name)}</option>`).join("");document.getElementById("title").value="";document.getElementById("noteContent").value="";document.getElementById("editor").style.display="flex"}
function closeModal(){document.getElementById("editor").style.display="none"}
function editNote(id){let n=notes.find(x=>x.id===id);if(!n)return;editingId=id;document.getElementById("editorTitle").textContent="Notu Düzenle";document.getElementById("cat").innerHTML=categories.map(c=>`<option value="${c.id}" ${c.name===n.category?"selected":""}>${esc(c.name)}</option>`).join("");document.getElementById("title").value=n.title;document.getElementById("noteContent").value=n.content;document.getElementById("editor").style.display="flex"}
async function saveNote(){
 let title=document.getElementById("title").value.trim(),content=document.getElementById("noteContent").value.trim(),categoryId=document.getElementById("cat").value,catName=categories.find(c=>c.id===categoryId)?.name||"Genel";if(!title)return alert("Başlık gir.");
 let payload={title,content,category:catName,updated_at:new Date().toISOString()};
 let r=editingId?await sb.from("notes").update(payload).eq("id",editingId):await sb.from("notes").insert({...payload,user_id:session.user.id});
 if(r.error)return alert(r.error.message);closeModal();await loadNotes();renderHome();toast("Kaydedildi.")
}
async function toggleArchive(id){let n=notes.find(x=>x.id===id);let r=await sb.from("notes").update({archived:!n.archived,updated_at:new Date().toISOString()}).eq("id",id);if(r.error)alert(r.error.message);else{await loadNotes();renderHome();toast(n.archived?"Arşivden çıkarıldı":"Arşivlendi")}}
async function deleteNote(id){if(!confirm("Bu kaydı kalıcı olarak silmek istediğine emin misin?"))return;let r=await sb.from("notes").delete().eq("id",id);if(r.error)alert(r.error.message);else{await loadNotes();renderHome();toast("Silindi")}}
async function exportData(){let data=notes;let blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json"}),a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="roleplay-log-yedek-"+new Date().toISOString().slice(0,10)+".json";a.click();URL.revokeObjectURL(a.href)}
async function renderAdmin(){
 if(!isAdmin()){renderHome();return}
 let users=await sb.from("profiles").select("*").order("created_at",{ascending:false});let cs=categories;
 document.getElementById("heading").textContent="Admin Paneli";document.getElementById("subheading").textContent="Sistem ve içerik yönetimi";
 document.getElementById("content").innerHTML=`<div class="panel"><h2>Site Ayarları</h2><label>Site adı</label><input id="setName" class="field"><label>Logo URL</label><input id="setLogo" class="field" placeholder="https://..."><div class="actions" style="margin-top:12px"><button class="primary" onclick="saveSettings()">Kaydet</button></div></div>
 <div class="panel"><h2>Kategoriler</h2><div class="actions"><input id="newCat" class="field" style="max-width:300px" placeholder="Yeni kategori"><button class="primary" onclick="addCategory()">＋ Ekle</button></div><table class="table"><tbody>${cs.map(c=>`<tr><td>${esc(c.name)}</td><td><button class="danger" onclick="deleteCategory('${c.id}')">Sil</button></td></tr>`).join("")}</tbody></table></div>
 <div class="panel"><h2>Kullanıcılar</h2><table class="table"><thead><tr><th>E-posta</th><th>Rol</th><th>Kayıt</th></tr></thead><tbody>${(users.data||[]).map(u=>`<tr><td>${esc(u.email||"")}</td><td>${esc(u.role)}</td><td>${new Date(u.created_at).toLocaleDateString("tr-TR")}</td></tr>`).join("")}</tbody></table></div>`
 let s=await sb.from("site_settings").select("*").limit(1).single();if(s.data){document.getElementById("setName").value=s.data.site_name||"";document.getElementById("setLogo").value=s.data.logo_url||""}
}
async function saveSettings(){let site_name=document.getElementById("setName").value.trim()||"ROLEPLAY LOG",logo_url=document.getElementById("setLogo").value.trim();let r=await sb.from("site_settings").update({site_name,logo_url}).eq("id",1);if(r.error)alert(r.error.message);else{await loadSettings();toast("Ayarlar kaydedildi")}}
async function addCategory(){let name=document.getElementById("newCat").value.trim();if(!name)return;let r=await sb.from("categories").insert({name});if(r.error)alert(r.error.message);else{document.getElementById("newCat").value="";await loadCategories();renderNav();renderAdmin()}}
async function deleteCategory(id){if(!confirm("Kategori silinsin mi?"))return;let r=await sb.from("categories").delete().eq("id",id);if(r.error)alert(r.error.message);else{await loadCategories();renderNav();renderAdmin()}}
boot();
</script>
</body></html>
